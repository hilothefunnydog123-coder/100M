# Copy to .env (git-ignored) or set in your host's secret manager.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown)
# SPOTCHECK_MODEL=claude-opus-5-5
# SPOTCHECK_EFFORT=high
# SPOTCHECK_ENSEMBLE_SIZE=1
# SPOTCHECK_FALLBACKS=true
# SPOTCHECK_CORS_ORIGINS=https://your.domain
# SPOTCHECK_RATE_LIMIT_INSTALL_BURST=6
# SPOTCHECK_RATE_LIMIT_INSTALL_REFILL_MINUTES=10
# SPOTCHECK_RATE_LIMIT_IP_BURST=30
# SPOTCHECK_RATE_LIMIT_IP_REFILL_MINUTES=2
# SPOTCHECK_MAX_CONCURRENT=16
# SPOTCHECK_MAX_QUEUED=64
# PORT=8080

# Local development without a key: canned demo results
# SPOTCHECK_FAKE_MODEL=true
