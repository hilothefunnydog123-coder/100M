# Copy to .env and fill in. Every setting is described in docs/DEPLOY.md.

# --- Required in production ---------------------------------------------
JOBWALK_ENV=production
# Supabase: Connect > Session pooler, with your password filled in.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Per server. Supabase's session pooler allows 15 connections in all.
DATABASE_POOL_SIZE=5
JOBWALK_PUBLIC_URL=https://jobwalk.app
# 32+ random characters: openssl rand -base64 48
JOBWALK_SECRET=
# Or GEMINI_API_KEY or GROQ_API_KEY with JOBWALK_AI_PROVIDER (Model, below).
ANTHROPIC_API_KEY=

# --- Email (sign-in codes and notifications) ---------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Jobwalk <hello@jobwalk.app>
EMAIL_REPLY_TO=

# --- Photo storage -------------------------------------------------------
# file keeps photos on a volume (one instance). s3 works with Supabase
# Storage, R2, S3, MinIO. Supabase: Storage > S3 settings.
STORAGE=s3
S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
S3_BUCKET=jobwalk
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Stripe (optional: billing and card deposits) ----------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_CREW=
# Jobwalk's cut of deposits in basis points (100 = 1%), plus card fees
# passed through (2.9% + 30 cents by default).
STRIPE_APPLICATION_FEE_BPS=100

# --- Operations ----------------------------------------------------------
ADMIN_TOKEN=
METRICS_TOKEN=
# Load balancers in front of the server (for client IPs in audit trails).
JOBWALK_TRUSTED_PROXIES=1
JOBWALK_CORS_ORIGINS=*

# --- Model ---------------------------------------------------------------
# claude (ANTHROPIC_API_KEY), gemini (GEMINI_API_KEY), or groq
# (GROQ_API_KEY); see docs/DEPLOY.md.
JOBWALK_AI_PROVIDER=claude
JOBWALK_MODEL=claude-opus-5-5
JOBWALK_EFFORT=high
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Legal pages (/privacy and /terms) ---------------------------------
# Who runs Jobwalk: your own legal name as a sole proprietor, or your
# company's registered name once you have one, e.g. Jobwalk LLC.
JOBWALK_LEGAL_NAME=
JOBWALK_LEGAL_ADDRESS=
# The US state whose laws govern the terms, e.g. Texas.
JOBWALK_GOVERNING_LAW=
JOBWALK_CONTACT_EMAIL=

# --- App store review (optional) ----------------------------------------
JOBWALK_REVIEW_EMAIL=
JOBWALK_REVIEW_CODE=
